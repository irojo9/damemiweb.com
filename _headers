/*
  X-Robots-Tag: index, follow
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

# Las tipografias van con hash en el contenido y no cambian nunca:
# se cachean un ano para que solo se descarguen en la primera visita.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Imagenes: una semana en el navegador y se revalidan en segundo plano
# (las capturas del portfolio se regeneran una vez al mes).
/proyectos-capturas/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/juego-mudanzas/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Script comun: un dia, y mientras tanto se revalida sin bloquear.
/dmw.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
